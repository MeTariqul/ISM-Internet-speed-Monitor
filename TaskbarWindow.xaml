<Window x:Class="SpeedMonitor.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Monitor"
        Height="48"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- The window is click-through (see MakeClickThrough), so the taskbar underneath keeps
         receiving every click; the readout is pure decoration. -->
    <Border Padding="10,0" Background="Transparent">
        <TextBlock x:Name="ValueText"
                   Text="{Binding TaskbarText}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="#FFF2F5F7" />
    </Border>

</Window>
