<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpeedMonitor</RootNamespace>
    <AssemblyName>ISM-Internet-Speed-Monitor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ISM - Internet Speed Monitor</AssemblyTitle>
    <Product>ISM - Internet Speed Monitor</Product>
    <Version>1.4.0</Version>
    <Authors>MeTariqul</Authors>
    <Company>MeTariqul</Company>
    <Copyright>Copyright (c) MeTariqul - github.com/MeTariqul</Copyright>
    <Description>Internet Speed Monitor (ISM): a DU Meter style network / disk / CPU / RAM readout drawn inside the Windows taskbar.</Description>
    <RepositoryUrl>https://github.com/MeTariqul/ISM-Internet-speed-Monitor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MeTariqul/ISM-Internet-speed-Monitor</PackageProjectUrl>
    <!-- WFAC010: DPI is configured in app.manifest (which is what WPF reads), not via the WinForms API. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Avoid System.Drawing / System.Windows.Forms leaking into WPF code via implicit usings. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!--
    legacy/ holds the old v1.0 implementation (frozen, own solution).
    tests/ holds the xUnit project. Neither may be compiled into the app.
  -->
  <ItemGroup>
    <Compile Remove="legacy/**;tests/**" />
    <Page Remove="legacy/**;tests/**" />
    <ApplicationDefinition Remove="legacy/**;tests/**" />
    <EmbeddedResource Remove="legacy/**;tests/**" />
    <None Remove="legacy/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- Ed25519 verification for offline license tokens (.NET 8 has no built-in Ed25519 API). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
